{
  "name": "@rcrt/sdk",
  "version": "0.1.1",
  "description": "RCRT Consumer SDK — the primary way consumer apps connect to + build on the RCRT platform (TypeScript).",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://australia-southeast1-npm.pkg.dev/possibl-rcrt-au-dev-498105/rcrt-npm/"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "rcrt",
    "ai",
    "agents",
    "sdk",
    "breadcrumbs",
    "lod",
    "typescript"
  ],
  "author": "Possibl (https://possibl.ai)",
  "repository": {
    "type": "git",
    "url": "https://github.com/possibl-ai/rcrt-platform.git",
    "directory": "packages/sdk"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.5",
    "tsx": "^4.21.1",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.64.0",
    "vitest": "^2.1.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "type-check": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "codegen": "openapi-typescript ../../docs/api/openapi.yaml -o ./src/api/openapi.ts",
    "codegen:check": "openapi-typescript ../../docs/api/openapi.yaml -o /tmp/rcrt-sdk-openapi-check.ts && prettier --config .prettierrc.json --write /tmp/rcrt-sdk-openapi-check.ts && diff -q ./src/api/openapi.ts /tmp/rcrt-sdk-openapi-check.ts"
  }
}